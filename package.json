{
  "name": "code-agent",
  "version": "0.2.0",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "postinstall": "node scripts/install-electron.cjs",
    "build": "tsc -p tsconfig.electron.json && tsc -p tsconfig.renderer.json && vite build",
    "start": "npm run build && electron .",
    "test": "npm run build:main && node --test tests/*.test.mjs",
    "build:main": "tsc -p tsconfig.electron.json"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "dompurify": "3.4.16",
    "lucide-react": "^0.468.0",
    "marked": "^14.0.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "overrides": {
    "dompurify": "3.4.16"
  }
}
